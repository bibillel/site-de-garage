datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id        Int    @id @default(autoincrement())
  email     String @unique
  password  String
  firstName String
  lastName  String
  role      Role

  clientsCreated        Client[]       @relation("ClientCreatedBy")
  interventionsCreated Intervention[] @relation("InterventionCreatedBy")
  interventionsAssigned Intervention[] @relation("InterventionAssignedTo")
}

model Client {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  email     String?
  phone     String?
  address   String?

  createdByUserId Int
  createdBy       User @relation("ClientCreatedBy", fields: [createdByUserId], references: [id])

  vehicles Vehicle[]
}

model Vehicle {
  id           Int    @id @default(autoincrement())
  brand        String
  model        String
  year         Int?
  mileage      Int?
  registration String @unique

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  interventions Intervention[]
}

model Intervention {
  id          Int      @id @default(autoincrement())
  description String
  status      String
  laborCost   Int
  partsCost   Int
  totalCost   Int
  date        DateTime @default(now())

  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  createdByUserId Int
  createdBy       User @relation("InterventionCreatedBy", fields: [createdByUserId], references: [id])

  assignedUserId Int
  assignedUser   User @relation("InterventionAssignedTo", fields: [assignedUserId], references: [id])
}